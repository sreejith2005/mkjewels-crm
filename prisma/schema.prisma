generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Branch {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String                 @unique @db.VarChar(120)
  address              String?
  active               Boolean                @default(true)
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  timelineEvents       ClientTimeline[]
  clientsLastVisited   Client[]               @relation("ClientLastBranch")
  crmAllocations       CrmAllocation[]
  crmDailyAvailability CrmDailyAvailability[]
  entryQueueItems      EntryQueue[]
  users                User[]
  notBoughtFollowups   NotBoughtFollowup[]
  referrals            Referral[]

  @@map("branches")
}

model User {
  /// Must equal the corresponding Supabase auth.users.id.
  id                     String              @id @db.Uuid
  name                   String              @db.VarChar(160)
  phone                  String?             @db.VarChar(30)
  email                  String              @unique @db.VarChar(320)
  role                   UserRole
  branchId               String?             @map("branch_id") @db.Uuid
  active                 Boolean             @default(true)
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  clientEdits            ClientEditLog[]
  timelineEvents         ClientTimeline[]
  lastSalespersonClients Client[]            @relation("ClientLastSalesperson")
  updatedClients         Client[]            @relation("ClientProfileUpdatedBy")
  uploadedDocuments      Document[]
  enteredFollowups       NotBoughtFollowup[]
  followupUpdates        NotBoughtHistory[] @relation("NotBoughtHistoryUpdatedBy")
  referrals              Referral[]
  referralCallUpdates    ReferralCallingHistory[] @relation("ReferralCallingHistoryUpdatedBy")
  campaignsCreated       Campaign[]              @relation("CampaignCreatedBy")
  campaignTagsApplied    ClientCampaignTag[]     @relation("ClientCampaignTagTaggedBy")
  branch                 Branch?             @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([branchId])
  @@index([role, active])
  @@map("users")
}

model Client {
  clientId                String              @id @default(dbgenerated("gen_random_uuid()")) @map("client_id") @db.Uuid
  primaryName             String              @map("primary_name") @db.VarChar(160)
  otherNames              String[]            @default([]) @map("other_names")
  primaryPhone            String              @map("primary_phone") @db.VarChar(30)
  secondaryPhone          String?             @map("secondary_phone") @db.VarChar(30)
  billingPhone            String?             @map("billing_phone") @db.VarChar(30)
  otherKnownPhones        String[]            @default([]) @map("other_known_phones")
  gender                  String?             @db.VarChar(40)
  country                 String?             @db.VarChar(100)
  state                   String?             @db.VarChar(100)
  city                    String?             @db.VarChar(120)
  cityOther               String?             @map("city_other") @db.VarChar(120)
  pincode                 String?             @db.VarChar(12)
  address                 String?
  community               String?             @db.VarChar(120)
  communityOther          String?             @map("community_other") @db.VarChar(120)
  dob                     DateTime?           @db.Date
  anniversary             DateTime?           @db.Date
  beverage                String?             @db.VarChar(100)
  sugar                   String?             @db.VarChar(60)
  snack                   String?             @db.VarChar(100)
  giftHistory             Json?               @map("gift_history")
  totalVisits             Int                 @default(0) @map("total_visits")
  totalPurchaseVisits     Int                 @default(0) @map("total_purchase_visits")
  totalNonPurchaseVisits  Int                 @default(0) @map("total_non_purchase_visits")
  totalRepairVisits       Int                 @default(0) @map("total_repair_visits")
  totalOrderVisits        Int                 @default(0) @map("total_order_visits")
  firstVisitDate          DateTime?           @map("first_visit_date") @db.Timestamptz(6)
  lastVisitDate           DateTime?           @map("last_visit_date") @db.Timestamptz(6)
  lastBuyStatus           BuyStatus?          @map("last_buy_status")
  lastBranchId            String?             @map("last_branch_id") @db.Uuid
  lastCrmName             String?             @map("last_crm_name") @db.VarChar(160)
  lastSalespersonId       String?             @map("last_salesperson_id") @db.Uuid
  lastRemark              String?             @map("last_remark")
  lastProductRequirement  String?             @map("last_product_requirement")
  lastSeenCategories      String[]            @default([]) @map("last_seen_categories")
  lastBoughtCategories    String[]            @default([]) @map("last_bought_categories")
  lastOrderCategories     String[]            @default([]) @map("last_order_categories")
  clientPotentialCategory String?             @map("client_potential_category") @db.VarChar(120)
  highPotentialReason     String?             @map("high_potential_reason")
  instagramStatus         String?             @map("instagram_status") @db.VarChar(80)
  googleReviewStatus      String?             @map("google_review_status") @db.VarChar(80)
  testimonialStatus       String?             @map("testimonial_status") @db.VarChar(80)
  referralStatus          String?             @map("referral_status") @db.VarChar(80)
  nextVisitDate           DateTime?           @map("next_visit_date") @db.Date
  profileUpdatedAt        DateTime            @default(now()) @updatedAt @map("profile_updated_at") @db.Timestamptz(6)
  profileUpdatedById      String?             @map("profile_updated_by") @db.Uuid
  editLog                 ClientEditLog[]
  phoneIndex              ClientPhoneIndex[]
  timeline                ClientTimeline[]
  lastBranch              Branch?             @relation("ClientLastBranch", fields: [lastBranchId], references: [id])
  lastSalesperson         User?               @relation("ClientLastSalesperson", fields: [lastSalespersonId], references: [id])
  profileUpdatedBy        User?               @relation("ClientProfileUpdatedBy", fields: [profileUpdatedById], references: [id])
  documents               Document[]
  entryQueueItems         EntryQueue[]
  notBoughtFollowups      NotBoughtFollowup[]
  referralsGiven          Referral[]
  convertedReferralCalls  ReferralCalling[]   @relation("ReferralConvertedClient")
  campaignTags            ClientCampaignTag[]

  @@index([primaryPhone])
  @@index([lastBranchId, lastVisitDate])
  @@index([lastSalespersonId])
  @@index([profileUpdatedById])
  @@index([nextVisitDate])
  @@map("clients")
}

model Campaign {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String              @unique @db.VarChar(200)
  description String?
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?             @map("created_by") @db.Uuid
  createdBy   User?               @relation("CampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  clientTags  ClientCampaignTag[]

  @@index([createdAt(sort: Desc)])
  @@index([createdById])
  @@map("campaigns")
}

model ClientCampaignTag {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId   String   @map("client_id") @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  taggedAt   DateTime @default(now()) @map("tagged_at") @db.Timestamptz(6)
  taggedById String?  @map("tagged_by") @db.Uuid
  note       String?
  client     Client   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  taggedBy   User?    @relation("ClientCampaignTagTaggedBy", fields: [taggedById], references: [id], onDelete: SetNull)

  @@unique([clientId, campaignId])
  @@index([campaignId, taggedAt(sort: Desc)])
  @@index([taggedById])
  @@map("client_campaign_tags")
}

model ClientPhoneIndex {
  phone    String @id @db.VarChar(30)
  clientId String @map("client_id") @db.Uuid
  client   Client @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@index([clientId])
  @@map("client_phone_index")
}

model ClientTimeline {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId           String     @map("client_id") @db.Uuid
  eventDate          DateTime   @map("event_date") @db.Timestamptz(6)
  eventType          EventType  @default(VISIT) @map("event_type")
  buyStatus          BuyStatus? @map("buy_status")
  branchId           String     @map("branch_id") @db.Uuid
  crmName            String?    @map("crm_name") @db.VarChar(160)
  salespersonId      String?    @map("salesperson_id") @db.Uuid
  seenCategories     String[]   @default([]) @map("seen_categories")
  boughtCategories   String[]   @default([]) @map("bought_categories")
  orderCategories    String[]   @default([]) @map("order_categories")
  productRequirement String?    @map("product_requirement")
  remark             String?
  referenceNumber    String?    @map("reference_number") @db.VarChar(100)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  branch             Branch     @relation(fields: [branchId], references: [id])
  client             Client     @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  salesperson        User?      @relation(fields: [salespersonId], references: [id])
  documents          Document[]
  visitForm          VisitForm?
  sourceFollowups    NotBoughtFollowup[] @relation("NotBoughtFollowupSourceTimeline")
  sourceReferrals    Referral[]          @relation("ReferralSourceTimeline")

  @@unique([id, clientId])
  @@index([clientId, eventDate(sort: Desc)])
  @@index([branchId, eventDate(sort: Desc)])
  @@index([salespersonId, eventDate(sort: Desc)])
  @@index([referenceNumber])
  @@map("client_timeline")
}

model ClientEditLog {
  id         BigInt   @id @default(autoincrement())
  clientId   String   @map("client_id") @db.Uuid
  editedById String?  @map("edited_by") @db.Uuid
  source     String   @default("database_trigger") @db.VarChar(100)
  fieldName  String   @map("field_name") @db.VarChar(120)
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  client     Client   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  editedBy   User?    @relation(fields: [editedById], references: [id])

  @@index([clientId, createdAt(sort: Desc)])
  @@index([editedById])
  @@map("client_edit_log")
}

model LegacyWalkinIngestAttempt {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId   String   @unique @map("request_id") @db.Uuid
  sourceIp    String?  @map("source_ip") @db.VarChar(64)
  payload     Json
  payloadHash String?  @map("payload_hash") @db.VarChar(64)
  outcome     String   @db.VarChar(40)
  result      Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@index([outcome, createdAt(sort: Desc)])
  @@map("legacy_walkin_ingest_attempts")
}

model VisitForm {
  id                      String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientTimelineId        String         @unique @map("client_timeline_id") @db.Uuid
  companions              Json           @default("[]")
  categoryDetails         Json           @default("{}") @map("category_details")
  occupation              String?        @db.VarChar(120)
  occupationOther         String?        @map("occupation_other") @db.VarChar(160)
  bridalOrNonBridal       String?        @map("bridal_or_non_bridal") @db.VarChar(40)
  weddingMonth            Int?           @map("wedding_month") @db.SmallInt
  weddingYear             Int?           @map("wedding_year") @db.SmallInt
  communicationPreference String?        @map("communication_preference") @db.VarChar(80)
  sourceOfLead            String?        @map("source_of_lead") @db.VarChar(120)
  sourceOfLeadOther       String?        @map("source_of_lead_other") @db.VarChar(160)
  referenceName           String?        @map("reference_name") @db.VarChar(160)
  referencePhone          String?        @map("reference_phone") @db.VarChar(30)
  clientType              String?        @map("client_type") @db.VarChar(20)
  didBuy                  Boolean?       @map("did_buy")
  notBoughtReasons        String[]       @default([]) @map("not_bought_reasons")
  notBoughtOther          String?        @map("not_bought_other")
  repairOrOrderApproach   String?        @map("repair_or_order_approach")
  marketingMessageSent    String?        @map("marketing_message_sent")
  feedbackFormAsked       Boolean?       @map("feedback_form_asked")
  feedbackFormNoReason    String?        @map("feedback_form_no_reason")
  feedbackFormProofUrl    String?        @map("feedback_form_proof_url")
  instagramAsked          Boolean?       @map("instagram_asked")
  instagramNoReason       String?        @map("instagram_no_reason")
  instagramProofUrl       String?        @map("instagram_proof_url")
  googleReviewAsked       Boolean?       @map("google_review_asked")
  googleReviewNoReason    String?        @map("google_review_no_reason")
  googleReviewProofUrl    String?        @map("google_review_proof_url")
  testimonialAsked        Boolean?       @map("testimonial_asked")
  testimonialNoReason     String?        @map("testimonial_no_reason")
  testimonialProofUrl     String?        @map("testimonial_proof_url")
  thankYouNoteAsked       Boolean?       @map("thank_you_note_asked")
  thankYouNoteNoReason    String?        @map("thank_you_note_no_reason")
  thankYouNoteProofUrl    String?        @map("thank_you_note_proof_url")
  referralsAsked          Boolean?       @map("referrals_asked")
  referralsNoReason       String?        @map("referrals_no_reason")
  referralsProofUrl       String?        @map("referrals_proof_url")
  additionalFields        Json           @default("{}") @map("additional_fields")
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  clientTimeline          ClientTimeline @relation(fields: [clientTimelineId], references: [id], onDelete: Cascade)
  sourceFollowups         NotBoughtFollowup[] @relation("NotBoughtFollowupSourceVisitForm")
  sourceReferrals         Referral[]          @relation("ReferralSourceVisitForm")

  @@index([clientType])
  @@index([didBuy])
  @@index([occupation])
  @@index([bridalOrNonBridal, weddingYear, weddingMonth])
  @@map("visit_forms")
}

model Document {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId         String          @map("client_id") @db.Uuid
  clientTimelineId String?         @map("client_timeline_id") @db.Uuid
  uploadedById     String          @map("uploaded_by") @db.Uuid
  fileName         String          @map("file_name")
  storagePath      String          @unique @map("storage_path")
  mimeType         String          @map("mime_type") @db.VarChar(255)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  client           Client          @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  clientTimeline   ClientTimeline? @relation(fields: [clientTimelineId, clientId], references: [id, clientId])
  uploadedBy       User            @relation(fields: [uploadedById], references: [id])

  @@index([clientId, createdAt(sort: Desc)])
  @@index([clientTimelineId])
  @@index([uploadedById])
  @@map("documents")
}

model EntryQueue {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token             String    @unique @db.VarChar(40)
  clientName        String    @map("client_name") @db.VarChar(160)
  mobile            String    @db.VarChar(30)
  branchId          String    @map("branch_id") @db.Uuid
  assignedCrmName   String?   @map("assigned_crm_name") @db.VarChar(160)
  status            String    @default("waiting") @db.VarChar(60)
  fullFormTimestamp DateTime? @map("full_form_timestamp") @db.Timestamptz(6)
  clientId          String?   @map("client_id") @db.Uuid
  remark            String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  branch            Branch    @relation(fields: [branchId], references: [id])
  client            Client?   @relation(fields: [clientId], references: [clientId])

  @@index([branchId, status, createdAt])
  @@index([clientId])
  @@map("entry_queue")
}

model CrmAllocation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  crmName   String   @map("crm_name") @db.VarChar(160)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, crmName])
  @@index([branchId, active])
  @@map("crm_allocation")
}

model CrmDailyAvailability {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  crmName     String   @map("crm_name") @db.VarChar(160)
  date        DateTime @db.Date
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, crmName, date])
  @@index([branchId, date, isAvailable])
  @@map("crm_daily_availability")
}

model NotBoughtFollowup {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId         String             @map("client_id") @db.Uuid
  referenceNumber  String?            @map("reference_number") @db.VarChar(100)
  status           String             @db.VarChar(80)
  nextFollowupDate DateTime?          @map("next_followup_date") @db.Date
  callResponse     String?            @map("call_response")
  followupCount    Int                @default(0) @map("followup_count")
  remark           String?
  actionPoint      String?            @map("action_point")
  enteredById      String             @map("entered_by") @db.Uuid
  branchId         String?            @map("branch_id") @db.Uuid
  sourceTimelineId String?            @map("source_timeline_id") @db.Uuid
  sourceVisitFormId String?           @map("source_visit_form_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  client           Client             @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  enteredBy        User               @relation(fields: [enteredById], references: [id])
  branch           Branch?            @relation(fields: [branchId], references: [id])
  sourceTimeline   ClientTimeline?    @relation("NotBoughtFollowupSourceTimeline", fields: [sourceTimelineId], references: [id])
  sourceVisitForm  VisitForm?         @relation("NotBoughtFollowupSourceVisitForm", fields: [sourceVisitFormId], references: [id])
  history          NotBoughtHistory[]

  @@index([clientId, createdAt(sort: Desc)])
  @@index([status, nextFollowupDate])
  @@index([enteredById])
  @@index([referenceNumber])
  @@index([branchId, status, nextFollowupDate])
  @@index([sourceTimelineId])
  @@index([sourceVisitFormId])
  @@map("not_bought_followups")
}

model NotBoughtHistory {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  followupId String            @map("followup_id") @db.Uuid
  status     String            @db.VarChar(80)
  previousStatus String?       @map("previous_status") @db.VarChar(80)
  remark     String?
  callResponse String?         @map("call_response") @db.VarChar(40)
  updatedById String?          @map("updated_by") @db.Uuid
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  followup   NotBoughtFollowup @relation(fields: [followupId], references: [id], onDelete: Cascade)
  updatedBy  User?             @relation("NotBoughtHistoryUpdatedBy", fields: [updatedById], references: [id])

  @@index([followupId, createdAt(sort: Desc)])
  @@index([updatedById])
  @@map("not_bought_history")
}

model Referral {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  crmName         String?           @map("crm_name") @db.VarChar(160)
  salespersonId   String            @map("salesperson_id") @db.Uuid
  givenByClientId String            @map("given_by_client_id") @db.Uuid
  referralName    String            @map("referral_name") @db.VarChar(160)
  referralNumber  String            @map("referral_number") @db.VarChar(30)
  branchId        String?           @map("branch_id") @db.Uuid
  sourceTimelineId String?          @map("source_timeline_id") @db.Uuid
  sourceVisitFormId String?         @map("source_visit_form_id") @db.Uuid
  relationship      String?         @db.VarChar(120)
  bestTimeToCall    String?         @map("best_time_to_call") @db.VarChar(120)
  assignedDoer      String?         @map("assigned_doer") @db.VarChar(160)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  calling         ReferralCalling[]
  givenByClient   Client            @relation(fields: [givenByClientId], references: [clientId], onDelete: Cascade)
  salesperson     User              @relation(fields: [salespersonId], references: [id])
  branch          Branch?           @relation(fields: [branchId], references: [id])
  sourceTimeline  ClientTimeline?   @relation("ReferralSourceTimeline", fields: [sourceTimelineId], references: [id])
  sourceVisitForm VisitForm?        @relation("ReferralSourceVisitForm", fields: [sourceVisitFormId], references: [id])

  @@index([salespersonId, createdAt(sort: Desc)])
  @@index([givenByClientId])
  @@index([referralNumber])
  @@index([branchId, createdAt(sort: Desc)])
  @@index([assignedDoer])
  @@index([sourceTimelineId])
  @@index([sourceVisitFormId])
  @@map("referrals")
}

model ReferralCalling {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referralId       String    @map("referral_id") @db.Uuid
  status           String    @db.VarChar(80)
  remark           String?
  callResponse     String?   @map("call_response") @db.VarChar(40)
  followupCount    Int       @default(0) @map("followup_count")
  nextFollowupDate DateTime? @map("next_followup_date") @db.Date
  convertedClientId String?  @map("converted_client_id") @db.Uuid
  actionPoint      String?   @map("action_point")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  referral         Referral  @relation(fields: [referralId], references: [id], onDelete: Cascade)
  convertedClient  Client?   @relation("ReferralConvertedClient", fields: [convertedClientId], references: [clientId], onDelete: SetNull)
  history          ReferralCallingHistory[]

  @@index([referralId, createdAt(sort: Desc)])
  @@index([status, nextFollowupDate])
  @@index([convertedClientId])
  @@map("referral_calling")
}

model ReferralCallingHistory {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referralCallingId String        @map("referral_calling_id") @db.Uuid
  status         String          @db.VarChar(80)
  previousStatus String?         @map("previous_status") @db.VarChar(80)
  callResponse   String?         @map("call_response") @db.VarChar(40)
  remark         String?
  updatedById    String?         @map("updated_by") @db.Uuid
  enteredBy      String?         @map("entered_by") @db.VarChar(160)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  referralCalling ReferralCalling @relation(fields: [referralCallingId], references: [id], onDelete: Cascade)
  updatedBy      User?           @relation("ReferralCallingHistoryUpdatedBy", fields: [updatedById], references: [id])

  @@index([referralCallingId, createdAt(sort: Desc)])
  @@index([updatedById])
  @@map("referral_calling_history")
}

model LookupCity {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label  String  @unique @db.VarChar(160)
  active Boolean @default(true)

  @@index([active, label])
  @@map("lookup_cities")
}

model LookupPincode {
  id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pincode String  @unique @db.VarChar(12)
  city    String? @db.VarChar(160)
  state   String? @db.VarChar(100)
  country String? @db.VarChar(100)
  active  Boolean @default(true)

  @@index([active, pincode])
  @@index([city])
  @@map("lookup_pincodes")
}

model LookupCommunity {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label  String  @unique @db.VarChar(160)
  active Boolean @default(true)

  @@index([active, label])
  @@map("lookup_communities")
}

model LookupProductCategory {
