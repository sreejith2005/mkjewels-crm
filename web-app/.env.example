# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Supabase Dashboard > Project Settings > Database > Connection string.
# Use the transaction pooler for Vercel runtime connections.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Use the direct/session connection for Prisma migrations.
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Set in the Vercel Production environment and in the Apps Script Script Properties as MK_CRM_INGEST_API_KEY.
LEGACY_WALKIN_INGEST_API_KEY=replace-with-a-generated-secret

# Runo server-side lead allocation integration. Keep this server-only; never prefix it with NEXT_PUBLIC_.
RUNO_API_KEY=replace-with-runo-auth-key

# Optional idempotent bootstrap data consumed by `npm run db:seed`.
# Create each user in Supabase Auth first, then use that auth UUID here.
SEED_BRANCHES_JSON=[{"name":"Your branch name","address":"Your branch address"}]
SEED_USERS_JSON=[{"id":"AUTH_USER_UUID","name":"CRM Admin","email":"admin@example.com","role":"super_admin"}]
